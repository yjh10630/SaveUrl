<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 첫 프레임(Compose 렌더 전) 배경을 디자인 팔레트와 맞춘다. 다크는 values-night 참고 -->
    <style name="Theme.SaveUrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_window_background</item>
        <!-- 잠금 카테고리 인증: API 27 이하에서 biometric 라이브러리가 그리는 지문 대화상자(AppCompat AlertDialog)용 -->
        <item name="alertDialogTheme">@style/Theme.AppCompat.Light.Dialog.Alert</item>
    </style>

    <!-- 공유 빠른 저장 시트 (44번 §1.3): 보던 앱이 뒤에 그대로 보이는 반투명 창. 어둡게는 Compose 시트가 한다 -->
    <style name="Theme.SaveUrl.Share" parent="Theme.SaveUrl">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
        스플래시 (androidx core-splashscreen). MainActivity 의 시작 테마이며 installSplashScreen() 후 Theme.SaveUrl 로 바뀐다.
        배경은 라이트 #FFFFFF / 다크 #0F1115 (values-night 의 app_window_background),
        아이콘은 런처 글리프를 브랜드 블루 원 위에 올린다.
    -->
    <style name="Theme.SaveUrl.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/app_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_blue</item>
        <item name="postSplashScreenTheme">@style/Theme.SaveUrl</item>
    </style>
</resources>
