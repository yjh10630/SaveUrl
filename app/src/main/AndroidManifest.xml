<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TODO: 통신판매업 신고 완료 후 billing 복원 시 추가
    <uses-permission android:name="com.android.vending.BILLING" /> -->

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="*" />
        </intent>
        <!-- 링크 가져오기 안내의 "카톡 열기" (설치되어 있을 때만 보임) -->
        <package android:name="com.kakao.talk" />
    </queries>

    <!--
        링크는 서버로 보내지 않는다: allowBackup="false" 로 API 30 이하는 백업·기기 간 이전이 모두 꺼지고,
        API 31+ 는 data_extraction_rules 로 클라우드 백업만 막는다(기기 간 직접 이전은 유지).
        API 30 이하용 fullBackupContent 는 백업 자체가 꺼져 있어 필요 없으므로 DataExtractionRules 경고를 무시한다.
    -->
    <application
        android:name=".SaveUrlApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/icon_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaveUrl"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name"
            android:configChanges="uiMode"
            android:theme="@style/Theme.SaveUrl.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 링크 공유(text/plain) + 링크 가져오기: 카톡 대화 .txt/.zip, 북마크 .html, 백업 .csv (34번 §2.1) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${AdMobId}"/>
    </application>

</manifest>